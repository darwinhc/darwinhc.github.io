---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import avatar from '../assets/about/avatar.jpg';

const skills = [
  ['Languages', 'Python, Java, TypeScript, SQL, Bash'],
  ['Backend', 'FastAPI, Flask, Django, Spring Boot, REST and WebSocket APIs, microservices, serverless, hexagonal architecture, distributed systems'],
  ['Cloud and DevOps', 'AWS (Lambda, ECS, Fargate, API Gateway, CloudWatch), Azure, Terraform, CloudFormation, Docker, Kubernetes, GitHub Actions, CodeBuild, CI/CD'],
  ['Data and storage', 'PostgreSQL, SQL Server, Oracle Database, MongoDB, Redis, DynamoDB'],
  ['Messaging', 'Kafka, RabbitMQ, AWS SNS / SQS, EventBridge, SES, MQTT, event-driven architecture'],
  ['Data engineering', 'ETL pipelines, data integration, AWS Glue, Spark, Scrapy, Selenium'],
  ['AI and productivity', 'LangChain, RAG, OpenAI Codex, Cursor, Claude, OpenCode, OpenSpec, guardrails'],
  ['Observability', 'OpenTelemetry, Elastic Stack (ELK), CloudWatch, structured logging'],
];

const roles = [
  {
    title: 'Senior Backend Engineer · BairesDev',
    dates: '07/2025 — 03/2026',
    context: 'Remote · US healthcare communication platform for digital workflows across channels',
    bullets: [
      'Developed Python / FastAPI microservices and ETL pipelines on AWS ECS and Lambda.',
      'Processed 10,000+ personalised notifications daily with an event-driven architecture on SNS, SQS, EventBridge and SES; built REST APIs for notification and preference management.',
      'Built asynchronous workflows with dynamic content generation, configurable delivery schedules and AI-driven personalisation.',
      'Improved reliability with idempotency controls, DLQ handling and automated retries across Lambda and ECS services.',
      'Maintained 80%+ automated test coverage with Pytest, SonarQube and CI/CD pipelines.',
    ],
    tech: 'Python · FastAPI · PostgreSQL · AWS Lambda · ECS · SNS / SQS / SES · EventBridge · CloudWatch · Terraform · Docker · Pytest',
  },
  {
    title: 'Backend Engineer · SETI S.A.S',
    dates: '04/2022 — 07/2025',
    context: 'Remote · Enterprise ETL and integration platform used by a retailer with 40,000+ employees',
    bullets: [
      'Built Python and Spring Boot microservices and integrations for enterprise banking and retail platforms.',
      'Reduced development and testing effort by ~80% for a five-person team with a reusable Spring Boot migration framework.',
      'Migrated a legacy Python platform to cloud-native services, saving ~30 minutes of manual work per engineer daily.',
      'Modernised Python libraries with CI/CD, automated testing (80%+ coverage) and code quality controls.',
      'Supported 50+ ETL and integration processes, including 10 business-critical production workflows.',
      'Cut migration effort by ~5 hours per screen by automating the conversion of 100+ legacy reporting tables.',
    ],
    tech: 'Python · Flask · FastAPI · Java · Spring Boot · PostgreSQL · SQL Server · Oracle · Kafka · RabbitMQ · AWS · Azure · Azure Service Bus · Docker · Kubernetes · PySpark',
  },
  {
    title: 'Backend Engineer · AI messaging SaaS',
    dates: '11/2021 — 04/2022',
    context: 'AI-driven messaging platform for enterprise clients',
    bullets: [
      'Led the architecture and backend development, building scalable Python APIs and AWS serverless services.',
      'Designed reusable backend components with hexagonal architecture for framework-independent business logic.',
      'Developed event-driven messaging workflows integrated with external communication platforms through SNS / SQS and webhooks.',
      'Integrated an AI-powered workflow with a customer helpdesk platform to automate customer interactions.',
      'Reduced AWS operating costs by ~25% with a serverless-first architecture and optimised provisioning.',
    ],
    tech: 'Python · PostgreSQL · DynamoDB · AWS Lambda · SNS / SQS · EKS · Cognito · React · Next.js · Docker · ELK · Pytest',
  },
  {
    title: 'Python Developer · Freelance',
    dates: '07/2020 — 11/2021',
    context: 'Remote · Marketing automation and AI analytics',
    bullets: [
      'Built CNN-based systems for facial and voice emotion detection with deep learning and computer vision.',
      'Created REST APIs, ETL pipelines and web scrapers, and React (Next.js) front ends.',
    ],
    tech: 'Python · Flask · MongoDB · TensorFlow · Selenium · Scrapy · GCP · React',
  },
];

const projects = [
  {
    name: 'TKD Poomsae Scorer',
    href: '/work/tkd-poomsae-scorer/',
    text: 'Offline-first multi-judge scoring system for taekwondo competitions: Android judge app, local FastAPI server, live TV scoreboard. 240+ automated tests.',
  },
  {
    name: 'Realtime Events',
    href: '/work/realtime-events/',
    text: 'Real-time event management with a domain-first FastAPI backend, WebSocket updates and a React client. 100+ automated tests.',
  },
  {
    name: 'bisslog',
    href: '/bisslog/',
    text: 'Open-source hexagonal architecture toolkit for Python, published as seven packages on PyPI.',
  },
];
---

<Base
  title="CV · Darwin Herrera, Senior Backend Engineer"
  description="CV of Darwin Herrera, Senior Backend Engineer: Python, Java and AWS, event-driven systems, real-time applications and legacy migrations."
  contactTitle="Want to talk about a role or a project?"
>
  <div class="container cv">
    <header class="cv-head">
      <div>
        <h1>{site.fullName}</h1>
        <p class="role">{site.role} · {site.stackLine}</p>
        <p class="contacts small">
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.linkedin}>linkedin.com/in/darwin-herrera</a>
          <a href={site.github}>github.com/darwinhc</a>
        </p>
      </div>
      <Image src={avatar} alt="Darwin Herrera" width={192} height={192} class="cv-avatar" />
    </header>

    <p class="summary text-2">
      Backend engineer with 6+ years designing and building scalable systems in Python and Java (Spring Boot) on AWS and
      Azure: microservices, event-driven architectures, data integration and AI-powered features. I care about clean
      architecture, automated testing and systems that stay reliable in production.
    </p>

    <section class="cv-section" aria-labelledby="cv-skills">
      <h2 id="cv-skills">Skills</h2>
      <dl class="facts skills">
        {
          skills.map(([term, value]) => (
            <div>
              <dt>{term}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="cv-section" aria-labelledby="cv-experience">
      <h2 id="cv-experience">Experience</h2>
      <div class="entries">
        {
          roles.map((role) => (
            <article class="entry">
              <div class="entry-head">
                <h3>{role.title}</h3>
                <p class="mono dates">{role.dates}</p>
              </div>
              <p class="small muted">{role.context}</p>
              <ul>
                {role.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
              <p class="tech-line">{role.tech}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="cv-section" aria-labelledby="cv-projects">
      <h2 id="cv-projects">Selected projects</h2>
      <div class="entries">
        {
          projects.map((project) => (
            <article class="entry">
              <h3>
                <a href={project.href}>{project.name}</a>
              </h3>
              <p class="text-2">{project.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="cv-section" aria-labelledby="cv-education">
      <h2 id="cv-education">Education</h2>
      <div class="entries">
        <article class="entry">
          <div class="entry-head">
            <h3>B.Sc. Systems and Computer Engineering</h3>
            <p class="mono dates">09/2024</p>
          </div>
          <p class="text-2">National University of Colombia</p>
        </article>
      </div>
    </section>

    <div class="cv-section triple">
      <section aria-labelledby="cv-certs">
        <h2 id="cv-certs">Certifications</h2>
        <ul class="plain">
          <li>AWS Certified Cloud Practitioner <span class="mono muted">2026</span></li>
          <li>HiveMQ Certified MQTT Associate <span class="mono muted">2026</span></li>
        </ul>
      </section>
      <section aria-labelledby="cv-languages">
        <h2 id="cv-languages">Languages</h2>
        <ul class="plain">
          <li>English — C2</li>
          <li>Spanish — native</li>
          <li>German — A2, learning</li>
        </ul>
      </section>
      <section aria-labelledby="cv-interests">
        <h2 id="cv-interests">Interests</h2>
        <p class="text-2">Taekwondo (black belt), Toastmasters, fitness, football, travel</p>
      </section>
    </div>
  </div>
</Base>

<style>
  .cv {
    max-width: calc(960px + 2 * var(--gutter));
    padding-top: 72px;
    padding-bottom: 112px;
  }

  .cv-head {
    display: flex;
    flex-wrap: wrap-reverse;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line);
  }

  h1 {
    font-size: clamp(32px, 2vw + 20px, 44px);
    max-width: 20ch;
  }

  .role {
    margin-top: 8px;
    font-size: 19px;
    color: var(--text-2);
  }

  .contacts {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
  }

  .cv-head :global(.cv-avatar) {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
  }

  .summary {
    margin-top: 32px;
    max-width: 72ch;
    font-size: 18px;
  }

  .cv-section {
    margin-top: 64px;
  }

  .cv-section h2 {
    font-size: 24px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .skills {
    margin-top: 4px;
  }

  .skills > div:first-child {
    border-top: 0;
  }

  .entries {
    display: grid;
  }

  .entry {
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }

  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 24px;
  }

  .entry h3 {
    font-size: 18px;
  }

  .dates {
    font-size: 14px;
    color: var(--muted);
  }

  .entry > p {
    margin-top: 4px;
  }

  .entry ul {
    margin: 12px 0 0;
    padding-left: 18px;
    color: var(--text-2);
  }

  .entry li + li {
    margin-top: 4px;
  }

  .entry .tech-line {
    margin-top: 12px;
  }

  .triple {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 40px;
  }

  .plain {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    color: var(--text-2);
  }

  .plain li + li {
    margin-top: 6px;
  }

  .triple p {
    margin-top: 16px;
  }
</style>
