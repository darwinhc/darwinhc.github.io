---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  nav?: 'home' | 'inner';
  ogType?: 'website' | 'article';
  contactTitle?: string;
  contactText?: string;
  backToWork?: boolean;
}

const {
  title,
  description = site.description,
  nav = 'inner',
  ogType = 'website',
  contactTitle = 'Hiring, or have a system to build?',
  contactText = 'A short message on LinkedIn about the role or the project is enough to start. I answer every message.',
  backToWork = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/';
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  alternateName: site.name,
  jobTitle: site.role,
  description: site.description,
  url: Astro.site?.toString(),
  image: new URL('/assets/img/og.png', Astro.site).toString(),
  email: `mailto:${site.email}`,
  sameAs: [site.linkedin, site.github],
  knowsAbout: ['Python', 'Java', 'AWS', 'Event-driven architecture', 'Hexagonal architecture', 'FastAPI', 'Spring Boot'],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'National University of Colombia' },
};
const ogImage = new URL('/assets/img/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Darwin Herrera — writing" href="/feed.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    {
      site.goatcounter && (
        <script
          is:inline
          async
          data-goatcounter={`https://${site.goatcounter}.goatcounter.com/count`}
          src="//gc.zgo.at/count.js"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header variant={nav} />
    <main id="main">
      <slot />
      <Contact title={contactTitle} text={contactText} backToWork={backToWork} />
    </main>
    <Footer />
  </body>
</html>
