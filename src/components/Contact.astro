---
import { site } from '../data/site';
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  title: string;
  text?: string;
  /** Show the "See all work" link instead of email and GitHub (case studies). */
  backToWork?: boolean;
}
const { title, text, backToWork = false } = Astro.props;
---

<section id="contact" class="band contact" aria-labelledby="contact-title">
  <div class="container inner">
    <div class="copy">
      <h2 id="contact-title">{title}</h2>
      {text && <p class="lede">{text}</p>}
    </div>
    <div class="actions">
      <a class="btn btn-primary wide" href={site.linkedin}>Message me on LinkedIn <ArrowIcon /></a>
      <div class="link-row secondary">
        {
          backToWork ? (
            <a href="/#work">See all work</a>
          ) : (
            <>
              <a href={`mailto:${site.email}`}>{site.email}</a>
              <a href={site.github}>GitHub</a>
            </>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    border-bottom: 0;
  }

  .inner {
    padding-top: 112px;
    padding-bottom: 112px;
    display: flex;
    flex-wrap: wrap;
    gap: 40px 64px;
    align-items: flex-end;
    justify-content: space-between;
  }

  .copy {
    flex: 1 1 520px;
    min-width: 0;
  }

  h2 {
    font-size: clamp(34px, 2.4vw + 18px, 52px);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .lede {
    margin-top: 20px;
    max-width: 56ch;
  }

  .actions {
    flex: 0 1 380px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .wide {
    min-height: 56px;
    padding: 0 24px;
    justify-content: space-between;
  }

  .secondary {
    padding: 0 8px;
    font-size: 16px;
  }

  @media (max-width: 560px) {
    .inner {
      padding-top: 80px;
      padding-bottom: 80px;
    }
  }
</style>
